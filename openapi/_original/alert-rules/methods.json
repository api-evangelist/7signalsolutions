              "schema": {
                "$ref": "schema.json#/AlertRulesSummary"
              }
            }
          }
        },
        "400": {
          "$ref": "../common/schema.json#/400BadRequestResponse"
        },
        "403": {
          "$ref": "../common/schema.json#/403Forbidden"
        }
      },
      "tags": [
        "Alert Rules"
      ]
    }
  },
