                    ]
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/AlertRuleResponse"
              }
            }
          }
        },
        "400": {
          "$ref": "../common/schema.json#/400BadRequestResponse"
        },
        "403": {
          "$ref": "../common/schema.json#/403Forbidden"
        },
        "404": {
          "$ref": "../common/schema.json#/404NotFoundResponse"
        }
      },
      "tags": [
        "Alert Rules"
      ]
    },
    "delete": {
      "summary": "Delete an alert rule",
      "operationId": "delete-alert-rule",
      "description": "Delete an existing alert rule",
      "security": [
        {
          "oauth2": []
        }
      ],
      "parameters": [
        {
          "$ref": "../common/schema.json#/OrganizationRequestParam"
        },
        {
          "name": "id",
          "in": "path",
