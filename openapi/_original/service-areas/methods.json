  "PathServiceAreasSensorEyes": {
    "post": {
      "summary": "Add Eyes to a service area",
      "operationId": "sensor-service-area-add-eyes",
      "description": "Moves the given Eyes into this service area from wherever they currently are. Returns the updated service area. There is no separate \"remove\" endpoint - an Eye always belongs to some service area, so removing it from one only makes sense as adding it to another, which this same endpoint does",
      "security": [
        {
          "oauth2": []
        }
      ],
      "parameters": [
        {
          "$ref": "schema.json#/SensorServiceAreaId"
        }
