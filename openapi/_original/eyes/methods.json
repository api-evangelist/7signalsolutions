  "PathEyesSensorPcapDownload": {
    "get": {
      "summary": "Download packet capture file",
      "operationId": "get-eyes-sensor-pcap-download",
      "description": "Downloads the pcap file for the specified sensor and test key",
      "security": [
        {
          "oauth2": []
        }
      ],
      "parameters": [
        {
          "$ref": "schema.json#/RequiredSensorId"
        },
        {
          "$ref": "schema.json#/RequiredTestKey"
        }
      ],
      "responses": {
        "200": {
          "description": "pcap file returned",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/vnd.tcpdump.pcap": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "400": {
          "$ref": "../common/schema.json#/400BadRequestResponse"
        },
        "404": {
          "$ref": "../common/schema.json#/404NotFoundResponse"
        },
        "403": {
          "$ref": "../common/schema.json#/403Forbidden"
        }
      },
      "tags": [
        "Eyes"
      ]
    }
  },
  "PathEyesSensorPacketCaptureGlobal": {
    "get": {
      "summary": "List packet capture tests across all sensors",
      "operationId": "get-eyes-packet-captures-global",
      "description": "Retrieve a paginated, cross-sensor list of packet capture and access point traffic test pcaps. Omitting sensorId returns results across all sensors; providing it scopes to one sensor.",
      "security": [
        {
          "oauth2": []
        }
      ],
      "parameters": [
        {
          "name": "sensorId",
          "in": "query",
          "required": false,
          "description": "Scope results to a single sensor. Omit for cross-sensor results.",
          "schema": {
            "type": "integer"
          }
        },
        {
          "$ref": "schema.json#/PcapChannelRequestParam"
        },
        {
          "$ref": "schema.json#/PcapApIdRequestParam"
        },
        {
          "$ref": "schema.json#/PcapBandRequestParam"
        },
        {
          "$ref": "schema.json#/PcapStartRequestParam"
        },
        {
          "$ref": "schema.json#/PcapEndRequestParam"
        },
        {
          "name": "testType",
          "in": "query",
          "required": false,
          "description": "Filter by test type",
          "schema": {
            "type": "string",
            "enum": [
              "PacketCapture",
              "AccessPointTraffic"
            ]
          }
        },
        {
          "name": "searchValue",
          "in": "query",
          "required": false,
          "description": "Free-text search across sensor name, AP name, ESSID, and BSSID",
          "schema": {
            "type": "string"
          }
        },
        {
          "$ref": "schema.json#/PcapPageRequestParam"
        },
        {
          "$ref": "schema.json#/PcapSizeRequestParam"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/PacketCaptureListResponse"
              }
            }
          }
        },
        "400": {
          "$ref": "../common/schema.json#/400BadRequestResponse"
        },
        "404": {
          "$ref": "../common/schema.json#/404NotFoundResponse"
        }
      },
      "tags": [
        "Eyes"
      ]
    }
  },
