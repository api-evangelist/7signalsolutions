    "properties": {
      "accessPointId": {
        "type": "number"
      },
      "name": {
        "type": "string",
        "description": "Name of the grouped access point. Present when grouping by accessPoint.",
        "example": "TENNANTS_5GHz"
      },
      "network": {
        "type": "string",
        "description": "Network name. When grouping by accessPoint this is the ESSID the access point broadcasts; when grouping by networkband it is the configured name of the wireless network. The two are not guaranteed to be identical.",
        "example": "TENNANTS"
      },
      "bssid": {
        "type": "string",
        "description": "MAC address of the grouped access point. Present when grouping by accessPoint.",
        "example": "8C:30:66:A0:75:69"
      },
