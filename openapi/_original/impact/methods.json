  "PathImpactAgentsSummary": {
    "get": {
      "summary": "Retrieve Agent Impact Summary",
      "operationId": "impact-agents-summary",
      "description": "Retrieve a summary of agent impact metrics within a time range.",
      "security": [
        {
          "oauth2": []
        }
      ],
      "parameters": [
        {
          "$ref": "../common/schema.json#/OrganizationRequestParam"
        },
        {
          "$ref": "schema.json#/FromRequestParam"
        },
        {
          "$ref": "schema.json#/ToRequestParam"
        },
        {
          "$ref": "../common/schema.json#/PageRequestParam"
        },
        {
          "$ref": "../common/schema.json#/PerPageRequestParam"
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/GetAgentSummaryResponse"
              }
            }
          }
        },
        "400": {
          "$ref": "../common/schema.json#/400BadRequestResponse"
        },
        "404": {
          "$ref": "../common/schema.json#/404NotFoundResponse"
        }
      },
      "tags": [
        "Impact"
      ]
    }
  },
